generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteImage {
  id        String   @id @default(cuid())
  slot      String   @unique // e.g. "hero-bg", "hero-inset"
  url       String   // Vercel Blob URL
  alt       String   @default("")
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String   @default("")
  content     String   @default("")
  coverImage  String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Enquiry {
  id           String   @id @default(cuid())
  source       String   // "contact" | "product"
  status       String   @default("new") // "new" | "read" | "replied" | "closed"
  name         String
  email        String
  phone        String?
  company      String
  industry     String?
  application  String?
  message      String?
  partMaterial String?
  defectType   String?
  appDetails   String?
  sourcePage   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
