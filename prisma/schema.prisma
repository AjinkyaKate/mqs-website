generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteImage {
  id        String   @id @default(cuid())
  slot      String   @unique // e.g. "hero-bg", "hero-inset"
  url       String   // Vercel Blob URL
  alt       String   @default("")
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String   @default("")
  content     String   @default("")
  coverImage  String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Enquiry {
  id           String   @id @default(cuid())
  source       String   // "contact" | "product"
  status       String   @default("new") // "new" | "read" | "replied" | "closed"
  name         String
  email        String
  phone        String?
  company      String
  industry     String?
  application  String?
  message      String?
  partMaterial String?
  defectType   String?
  appDetails   String?
  sourcePage   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Careers applications. Kept separate from Enquiry: an application has its own
/// fields (department, experience, resume) and its own retention rule. The
/// careers form's DPDP notice promises deletion after 12 months, so createdAt
/// is what a cleanup job would filter on.
model Application {
  id         String   @id @default(cuid())
  status     String   @default("new") // "new" | "reviewed" | "shortlisted" | "archived"
  name       String
  email      String
  phone      String
  location   String   @default("")
  department String
  experience String   @default("")
  company    String   @default("")
  linkedin   String   @default("")
  message    String   @default("")
  /// Vercel Blob pathname, not a public URL. Resumes are stored with
  /// access: "private" and served only through an authenticated admin route.
  resumePath String
  resumeName String
  resumeSize Int
  /// When the applicant ticked the consent box, for DPDP record-keeping.
  consentAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
